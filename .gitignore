# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.cursor/
*.pem
public/API keys.txt
**/API keys.txt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local tooling
.claude/settings.local.json

# Raw supplied artwork. Kept out of public/ entirely — anything under public/
# is served to anyone who guesses the URL, and `vercel` uploads the working
# directory regardless of .gitignore. The processed, sized versions the site
# actually uses live in public/logos/.
design-source/
public/RR *.png
public/KDC *.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

.vercel
.env.vercel.local
